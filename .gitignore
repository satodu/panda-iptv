# ==============================================================================
# PANDA IPTV - .gitignore
# Regras completas de versionamento para Flutter, Linux Desktop, Android e IDEs
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FLUTTER & DART CORE
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
/build/
**/build/
dist/
/dist/
**/dist/
coverage/
/coverage/
**/doc/api/
.widget_preview/

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# ------------------------------------------------------------------------------
# 2. ANDROID ESPECÍFICO
# ------------------------------------------------------------------------------
.gradle/
**/android/.gradle/
**/android/captures/
**/android/gradleBuild/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
android/local.properties
**/android/local.properties
**/android/GeneratedPluginRegistrant.java
android/.cxx/
**/android/.cxx/

# Gradle wrapper caches
gradle-wrapper.jar
.gradle/caches/

# Chaves de Assinatura e Keystores (NUNCA COMMITAR!)
*.keystore
*.jks
key.properties
**/key.properties
google-services.json

# ------------------------------------------------------------------------------
# 3. LINUX DESKTOP ESPECÍFICO
# ------------------------------------------------------------------------------
linux/flutter/ephemeral/
**/linux/flutter/ephemeral/
linux/build/
**/linux/build/

# Artefatos C++ / CMake
*.o
*.a
*.so
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# ------------------------------------------------------------------------------
# 4. CONFIGURAÇÕES DE AMBIENTE E SEGREDOS
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.local
credentials.json

# ------------------------------------------------------------------------------
# 5. IDES E EDITORES DE CÓDIGO
# ------------------------------------------------------------------------------
# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/
out/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# Editores de Texto e Backup
*.swp
*.swo
*~
*.bak
*.tmp

# ------------------------------------------------------------------------------
# 6. SISTEMAS OPERACIONAIS
# ------------------------------------------------------------------------------
# Linux
.directory
/core
/core.[0-9]*
vgcore.*

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# 7. LOGS E ARTEFATOS TEMPORÁRIOS
# ------------------------------------------------------------------------------
*.log
*.class
*.pyc
npm-debug.log*
yarn-debug.log*
yarn-error.log*
